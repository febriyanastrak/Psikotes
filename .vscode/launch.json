{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "chrome",
            "request": "launch",
            "name": "Buka Web via Live Server (Port 5500)",
            "url": "http://127.0.0.1:5500/index.html",
            "webRoot": "${workspaceFolder}"
        },
        {
            "type": "chrome",
            "request": "launch",
            "name": "Buka Web via Local Server (Port 3000)",
            "url": "http://localhost:3000/index.html",
            "webRoot": "${workspaceFolder}"
        }
    ]
}